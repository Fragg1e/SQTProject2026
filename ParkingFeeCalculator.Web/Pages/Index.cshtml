@page
@model IndexModel
@{
    ViewData["Title"] = "Parking Fee Calculator";
}

<div class="page-card">
    <h1>Parking Fee Calculator</h1>
    <p class="page-note">Enter the hours parked and the vehicle type.</p>

    <form method="post" class="simple-form">
        <div class="mb-3">
            <label asp-for="Input.HoursParked" class="form-label"></label>
            <input asp-for="Input.HoursParked" id="hoursInput" class="form-control" />
            <span asp-validation-for="Input.HoursParked" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.VehicleType" class="form-label"></label>
            <input asp-for="Input.VehicleType" id="vehicleTypeInput" class="form-control" placeholder="standard or electric" />
            <span asp-validation-for="Input.VehicleType" class="text-danger"></span>
        </div>

        <button type="submit" id="calculateButton" class="btn btn-primary">Calculate Fee</button>
    </form>

    @if (Model.HasCalculated)
    {
        <div class="result-box" id="resultPanel">
            <strong>Calculated Fee:</strong>
            <span id="resultValue">@Model.ResultText</span>
        </div>
    }

    <div class="rules-box">
        <h2>Rules</h2>
        <ul>
            <li>Standard: 1 to 3 hours = EUR4 per hour</li>
            <li>Standard: 4+ hours = EUR3 per hour</li>
            <li>Electric: 1 to 5 hours = EUR3 per hour</li>
            <li>Electric: 6+ hours = EUR2 per hour</li>
            <li>10+ hours gets the discount</li>
            <li>Invalid hours or vehicle types return EUR0.00</li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
